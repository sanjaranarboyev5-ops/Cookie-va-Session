# MongoDB Atlas Connection String
# Almashtiring: <username>, <password>, <cluster-url> va database nomi
MONGODB_URI=mongodb+srv://admin:password123@cluster0.mongodb.net/cookie_session_auth?retryWrites=true&w=majority

# Server Port
PORT=5000

# Express Session Secret
SESSION_SECRET=super_secret_session_key_cookie_auth_2026

# Client URL (Frontend)
CLIENT_URL=http://localhost:5173

# Environment (development / production)
NODE_ENV=development

